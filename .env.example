# --- LLM (OpenAI-compatible). Switching cloud -> self-hosted = change LLM_BASE_URL only.
LLM_BASE_URL=https://models.jarvislabs.net/v1
# Self-hosted: LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=replace-me
LLM_MODEL=glm-5.3-flash
# low for demo speed, high for evaluation (endpoint default is max: slow and costly)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=120
LLM_MODE_LABEL=Cloud endpoint
# Shown in "About this model"
LLM_QUANT_LABEL=Full precision (managed endpoint)

# --- Vision model used at ingestion (defaults to LLM_*; set separately if the query model is text-only)
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# --- Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lowkey_docs
EMBED_MODEL_PATH=./models/bge-m3
RERANK_MODEL_PATH=./models/bge-reranker-v2-m3
RETRIEVE_TOP_K=30
RERANK_TOP_K=7
# Minimum reranker score (sigmoid, 0..1) for a chunk to be sent to the LLM
RERANK_MIN_SCORE=0.02
# Half-precision reranker: ~3x faster, same ranking in tests
RERANK_FP16=on

# --- Storage
DATA_DIR=./data
CORPUS_DIR=./corpus
AUDIT_DB_PATH=./data/audit.sqlite
USERS_FILE=./config/users.yaml

# --- Security
INJECTION_DEFENCE=on
TESSERACT_LANGS=tam+eng

# --- Runtime: never fetch from Hugging Face at runtime
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
